# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.

FLASK_APP=backend
FLASK_APP_VERSION=0.1.0

# Set to True for local development, False in production.
FLASK_DEBUG=True
FLASK_ENV=development

# Local dev: sqlite:///stockalert.db  (resolves to instance/stockalert.db)
FLASK_SQLALCHEMY_DATABASE_URI=sqlite:///stockalert.db

# Telegram bot credentials — get from BotFather on Telegram.
FLASK_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
FLASK_TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Background job interval (minutes).
FLASK_LAST_PRICES_FETCH_INTERVAL=15

# CORS origin for the Vue.js frontend.
# Local: http://localhost:5173
FLASK_FRONTEND_URL=http://localhost:5173

# ── VPS / DOCKER PRODUCTION ──────────────────────────────────────────────────
# On the VPS, copy this file to .env and change the values below:
#
# FLASK_DEBUG=false
# FLASK_ENV=production
#
# Absolute path matching the Docker volume mount in docker-compose.yml:
# FLASK_SQLALCHEMY_DATABASE_URI=sqlite:////data/stockalert.db
#
# FLASK_FRONTEND_URL=https://ivanstockalert.duckdns.org
#
# FLASK_TELEGRAM_BOT_TOKEN=<real token from BotFather>
# FLASK_TELEGRAM_CHAT_ID=<real chat id>
